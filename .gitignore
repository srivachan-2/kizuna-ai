# Specific Python lib ignores (do NOT ignore frontend/lib)
backend/lib/
backend/lib64/
venv/lib/
venv/lib64/
env/lib/
env/lib64/

# Explicitly ensure frontend source files are tracked
!frontend/lib/
!frontend/lib/**
!frontend/data/
!frontend/data/**

# Database
*.db
*.sqlite
*.sqlite3
backend/kizuna.db

# Secrets & Local Environment Variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env.local

# Allow committing demo/example configs
!frontend/.env.example
!.env.example

# IDE & OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
