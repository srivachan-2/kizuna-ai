.next/
out/
build/
dist/

# Python virtual environments & build artifacts
backend/venv/
backend/env/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
