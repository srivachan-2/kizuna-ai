# KIZUNA AI Environment Configuration
# Copy this file to .env or .env.local and configure your keys

# Backend Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./kizuna.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Gemini Configuration (Official Primary LLM Engine)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Frontend Settings (Public client variables only - NEVER put GEMINI_API_KEY here)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="KIZUNA AI"
